---
import Layout from '../layouts/Layout.astro';

const TURNSTILE_SITE_KEY = '0x4AAAAAADulaF08xHlZHPYf';
---

<Layout
  title="Contact Us | One Take Wonder Marketing"
  description="Get a free, no-obligation marketing proposal from One Take Wonder Marketing. Full-service marketing agency with over 10 years of proven ROI for local businesses."
>

<!-- Page Hero -->
<section class="relative bg-gray-900 py-20 px-6 overflow-hidden">
  <div class="absolute inset-0 opacity-25">
    <img src="/contact-office.jpg" alt="Modern office" class="w-full h-full object-cover" />
  </div>
  <div class="relative max-w-3xl mx-auto text-center">
    <p class="text-brand-pink-light font-semibold uppercase tracking-widest text-sm mb-4">Let's Talk</p>
    <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6">Ready to <span class="bg-gradient-to-r from-brand-pink-light to-brand-pink bg-clip-text text-transparent">Grow Your Business?</span></h1>
    <p class="text-gray-300 text-lg">
      Tell us about your goals and we'll put together a customized plan. No pressure, no obligation — just a clear path for what marketing that proves ROI can do for your business.
    </p>
  </div>
</section>

<!-- Contact Form & Info -->
<section class="py-20 px-6 bg-white">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-16">
      <!-- Form -->
      <div class="lg:col-span-3">
        <h2 class="text-2xl font-extrabold text-gray-900 mb-8">Schedule Your First Consultation</h2>
        <form id="contact-form" class="space-y-6" action="/api/contact" method="POST">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-2">Full Name *</label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-pink focus:border-brand-pink outline-none transition" placeholder="Your name" />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-gray-700 mb-2">Company *</label>
              <input type="text" id="company" name="company" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-pink focus:border-brand-pink outline-none transition" placeholder="Your business name" />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-pink focus:border-brand-pink outline-none transition" placeholder="you@company.com" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">Phone</label>
              <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-pink focus:border-brand-pink outline-none transition" placeholder="(555) 123-4567" />
            </div>
          </div>

          <div>
            <label for="interest" class="block text-sm font-medium text-gray-700 mb-2">I'm Interested In *</label>
            <select id="interest" name="interest" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-pink focus:border-brand-pink outline-none transition bg-white">
              <option value="">Select an option...</option>
              <option value="full-service">Full Service Marketing</option>
              <option value="media-buying">Media Buying (Broadcast, Cable, Streaming)</option>
              <option value="digital">Digital Marketing (SEO, PPC, Targeted Display)</option>
              <option value="web-design">Web Design</option>
              <option value="custom">Custom Campaign</option>
              <option value="not-sure">Not Sure — Need Guidance</option>
            </select>
          </div>

          <div>
            <label for="availability" class="block text-sm font-medium text-gray-700 mb-2">Best Days & Times for a Call or Meeting</label>
            <textarea id="availability" name="availability" rows="2" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-pink focus:border-brand-pink outline-none transition" placeholder="What days and times work best for you? We offer video calls for all clients, and in-person meetings if you're near Orlando, Florida."></textarea>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-2">Tell Us About Your Goals</label>
            <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brand-pink focus:border-brand-pink outline-none transition" placeholder="What are you looking to achieve? What's your timeline? Any budget range in mind?"></textarea>
          </div>

          <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>

          <button type="submit" class="btn-primary w-full text-center !py-4">Send</button>
          <p class="text-xs text-gray-400 text-center">We'll respond within 1 business day. No spam, no pressure.</p>
        </form>
        <div id="form-success" class="hidden mt-6 rounded-lg bg-green-50 border border-green-200 p-6 text-center">
          <p class="text-green-800 font-semibold">Thanks! Your request is on its way. 🎉</p>
          <p class="text-green-700 text-sm mt-1">We'll be in touch within 1 business day.</p>
        </div>
        <div id="form-error" class="hidden mt-4 rounded-lg bg-red-50 border border-red-200 p-4 text-center text-red-700 text-sm"></div>
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        <script>
          const f = document.getElementById('contact-form');
          const ok = document.getElementById('form-success');
          const err = document.getElementById('form-error');
          f?.addEventListener('submit', async (e) => {
            e.preventDefault();
            err.classList.add('hidden');
            const btn = f.querySelector('button[type=submit]');
            const label = btn.textContent;
            btn.disabled = true; btn.textContent = 'Sending…';
            try {
              // Get Turnstile token
              const turnstileToken = document.querySelector('[name="cf-turnstile-response"]')?.value;
              const formData = new FormData(f);
              if (turnstileToken) formData.append('cf-turnstile-response', turnstileToken);
              
        // Attach first-touch attribution stashed by Layout.astro. Pure DOM, so it
        // survives an analytics blocker — the case that made a real lead
        // unattributable on 2026-09-03.
        try {
          const _attr = JSON.parse(sessionStorage.getItem('rl_attr') || '{}');
          for (const k of ['referrer','referrer_host','landing_page','utm_source','utm_medium','utm_campaign','gclid']) {
            if (_attr[k]) formData.append('attr_' + k, _attr[k]);
          }
          const _ga = document.cookie.match(/(?:^|;\s*)_ga=GA\d\.\d\.(\d+\.\d+)/);
          if (_ga) formData.append('attr_ga_client_id', _ga[1]);
        } catch (e) { /* attribution is best-effort; never block the submission */ }
              const res = await fetch('/api/contact', { method: 'POST', body: formData });
              if (!res.ok) {
                // Reset Turnstile on failure
                if (window.turnstile) turnstile.reset();
                throw new Error((await res.json().catch(() => ({}))).error || 'Something went wrong');
              }
              if (typeof window.gtag === 'function') {
                window.gtag('event', 'generate_lead', {
                  customer_id: 'bg_113610_002aea',
                  form_id: 'contact',
                  form_type: 'consultation',
                  page_path: window.location.pathname,
                  event_version: 1,
                });
              }
              f.classList.add('hidden'); ok.classList.remove('hidden');
              ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } catch (e2) {
              err.textContent = e2.message; err.classList.remove('hidden');
              btn.disabled = false; btn.textContent = label;
            }
          });
        </script>
      </div>

      <!-- Contact Info -->
      <div class="lg:col-span-2">
        <div class="bg-gray-50 rounded-2xl p-8 sticky top-28">
          <h3 class="text-xl font-bold text-gray-900 mb-6">Other Ways to Reach Us</h3>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-brand-pink/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-brand-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.95.684l1.5 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.5a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <p class="font-medium text-gray-900 mb-2">Phone</p>
                <a href="tel:+13214838762" data-call-location="contact" class="btn-primary text-sm !px-5 !py-2.5">Call (321) 483-8762</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-brand-pink/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-brand-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <p class="font-medium text-gray-900">Email</p>
                <a href="mailto:pearl@onetakewonderproductions.com" class="text-brand-pink hover:text-brand-pink-dark transition-colors">pearl@onetakewonderproductions.com</a>
              </div>
            </div>

            <div class="border-t border-gray-200 pt-6">
              <h4 class="font-semibold text-gray-900 mb-3">What to Expect</h4>
              <ul class="space-y-3 text-sm text-gray-500">
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-brand-pink flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>We'll respond within 1 business day</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-brand-pink flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>Free 30-minute discovery call to understand your needs</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-brand-pink flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>Custom proposal tailored to your budget and goals</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-brand-pink flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span>No obligation, no pressure — just a clear plan</span>
                </li>
              </ul>
            </div>

            <div class="border-t border-gray-200 pt-6">
              <h4 class="font-semibold text-gray-900 mb-2">Based in the United States</h4>
              <p class="text-sm text-gray-500">Serving local businesses nationwide with customized marketing strategies that prove ROI.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

</Layout>
