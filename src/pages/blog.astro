---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Blog | One Take Wonder Marketing"
  description="Marketing insights, tips, and strategies from the team at One Take Wonder Marketing. Based in Orlando, Florida."
  canonical="blog"
>
  <section class="bg-gray-900 py-20 px-6">
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-brand-pink-light font-semibold uppercase tracking-widest text-sm mb-4">Blog</p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6">Marketing <span class="bg-gradient-to-r from-brand-pink-light to-brand-pink bg-clip-text text-transparent">Insights</span> & Strategies</h1>
      <p class="text-gray-300 text-lg max-w-2xl mx-auto">Practical marketing advice, industry trends, and behind-the-scenes perspectives from our team in Orlando, Florida.</p>
    </div>
  </section>

  <section class="py-20 px-6 bg-white">
    <div class="max-w-5xl mx-auto grid gap-8 md:grid-cols-2">
      {[

        {
          slug: 'marketing-strategy-that-proves-its-worth',
          date: 'August 17, 2026',
          title: 'Marketing Strategy That Makes Every Dollar Prove Its Worth',
          excerpt: 'Build a marketing strategy around your audience, budget, channels, and measurable ROAS before spending a dollar on paid media.',
          tag: 'Strategy Insights',
        },
        {
          slug: 'strategy',
          date: 'August 17, 2026',
          title: 'Top Questions About Strategy — Answered',
          excerpt: 'What marketing strategy really means, why it matters, and how to build a practical plan that makes every dollar count.',
          tag: 'Strategy Insights',
        },
        {
          slug: 'professional-media-buying-roi-diy-advertising',
          date: 'July 28, 2026',
          title: 'Why Professional Media Buying Delivers 3x the ROI of DIY Advertising',
          excerpt: 'Why expert media buying, smarter targeting, and continuous optimization deliver stronger returns than DIY advertising.',
          tag: 'Media Buying',
        },
        {
          slug: 'strategy-what-every-business-owner-should-know',
          date: 'July 21, 2026',
          title: 'Strategy: What Every Business Owner Should Know',
          excerpt: 'A practical guide to reaching the right people, choosing the right message and channels, and measuring what matters.',
          tag: 'Strategy Insights',
        },
        {
          slug: 'marketing-strategy-guide',
          date: 'July 14, 2026',
          title: 'The One Take Wonder Marketing Guide to Strategy: Why Strategy Comes Before Spending',
          excerpt: 'Why audience, objectives, measurement, and review cycles must come before choosing platforms or allocating spend.',
          tag: 'Strategy Insights',
        },
        {
          slug: 'ads-getting-clicks-no-customers-paid-media-conversion',
          date: 'June 15, 2026',
          title: 'Your Ads Are Getting Clicks. Here\'s Why They\'re Not Getting Customers.',
          excerpt: 'Five common reasons paid media earns clicks without customers—and the practical fixes that turn traffic into revenue.',
          tag: 'Paid Media Strategy',
        },
        {
          slug: 'full-service-marketing-strategy',
          date: 'May 20, 2026',
          title: 'Why Every Local Business Needs a Full-Service Marketing Strategy',
          excerpt: 'Why coordinated TV, digital, search, social, print, and creative outperform isolated single-channel tactics.',
          tag: 'Marketing Strategy',
        },
        {
          slug: 'tv-advertising-vs-digital-ads',
          date: 'May 12, 2026',
          title: 'TV Advertising vs. Digital Ads: Which Is Right for Your Business?',
          excerpt: 'Where television and digital advertising each excel—and why the strongest customer journeys often use both.',
          tag: 'Media Strategy',
        },
        {
          slug: 'marketing-on-a-budget',
          date: 'May 5, 2026',
          title: 'Marketing on a Budget: How Small Businesses Can Compete With Big Brands',
          excerpt: 'How smaller businesses can focus their channels, use existing assets, and make every paid-media dollar work harder.',
          tag: 'Small Business Marketing',
        },
        {
          slug: 'brand-consistency-across-every-channel',
          date: 'April 28, 2026',
          title: 'The Power of Brand Consistency Across Every Channel',
          excerpt: 'How consistent visuals, voice, messaging, and customer experience compound trust across every brand touchpoint.',
          tag: 'Brand Strategy',
        },
        {
          slug: 'measure-marketing-roi',
          date: 'April 20, 2026',
          title: 'How to Measure Marketing ROI (and Why Most Businesses Get It Wrong)',
          excerpt: 'How to define meaningful returns, count the true investment, connect spend to results, and calculate marketing ROI.',
          tag: 'Analytics & Reporting',
        },

      ].map((post) => (
        <a href={`/blog/${post.slug}`} class="group block rounded-2xl border border-gray-100 bg-white p-8 shadow-sm transition duration-200 hover:-translate-y-1 hover:border-brand-pink/30 hover:shadow-xl">
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="text-brand-pink text-xs font-bold uppercase tracking-wider">{post.tag}</span>
            <span class="text-gray-400 text-xs">{post.date}</span>
          </div>
          <h2 class="text-2xl font-extrabold text-gray-900 mb-4 transition-colors group-hover:text-brand-pink">{post.title}</h2>
          <p class="text-gray-600 leading-relaxed mb-5">{post.excerpt}</p>
          <span class="text-brand-pink font-semibold">Read article →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="py-20 px-6 bg-gray-900">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-6">Want Marketing Insights <span class="bg-gradient-to-r from-brand-pink-light to-brand-pink bg-clip-text text-transparent">Tailored to Your Business?</span></h2>
      <p class="text-gray-300 text-lg mb-10">Every business is different. Let's talk about what would work best for yours.</p>
      <a href="/contact" class="btn-primary text-lg !px-10 !py-4">Schedule Your First Consultation</a>
    </div>
  </section>
</Layout>
