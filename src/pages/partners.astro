---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Our Partners | One Take Wonder Marketing"
  description="One Take Wonder Marketing is proud to have partnered with local businesses across industries, helping them grow with customized marketing strategies and proven ROI."
>

<!-- Page Hero -->
<section class="bg-gray-900 py-20 px-6">
  <div class="max-w-7xl mx-auto text-center">
    <p class="text-brand-pink-light font-semibold uppercase tracking-widest text-sm mb-4">Our Partners</p>
    <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6">Businesses We've Helped <span class="bg-gradient-to-r from-brand-pink-light to-brand-pink bg-clip-text text-transparent">Grow</span></h1>
    <p class="text-gray-300 text-lg max-w-2xl mx-auto">
      One Take Wonder is proud to have been part of the growth strategy of all these local businesses along the years.
    </p>
  </div>
</section>

<!-- Partners by Industry -->
<section class="py-20 px-6 bg-white">
  <div class="max-w-7xl mx-auto">

    <!-- Healthcare & Medical -->
    <div class="mb-16">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-2">Healthcare & Medical</h2>
      <div class="w-12 h-1 bg-brand-pink mb-8"></div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Clínica San Felipe</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Earl Family Medicine</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Hear Care</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Kansas City Laser Like Lipo</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Live Free Home Health Care</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Olathe Chiropractic</p></div>
      </div>
    </div>

    <!-- Legal -->
    <div class="mb-16">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-2">Legal</h2>
      <div class="w-12 h-1 bg-brand-pink mb-8"></div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Gorny Law Firm</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">The Law Firm of Denise Ramos</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Thomas Fields Law Office</p></div>
      </div>
    </div>

    <!-- Home Services & Construction -->
    <div class="mb-16">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-2">Home Services & Construction</h2>
      <div class="w-12 h-1 bg-brand-pink mb-8"></div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Baxter Windows and Doors</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Bob Hamilton Plumbing</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Energy Pro Windows and Siding</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Flacare Cleaning Solutions</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Lima's Hardwood Floor</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Premium Wood Floors KC</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Profile Cabinets</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Rodrock Development</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Vaz Hardwood Floors KC</p></div>
      </div>
    </div>

    <!-- Automotive -->
    <div class="mb-16">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-2">Automotive</h2>
      <div class="w-12 h-1 bg-brand-pink mb-8"></div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">All-n-One Auto Parts</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Daniel's Auto Group</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Olathe Toyota</p></div>
      </div>
    </div>

    <!-- Restaurants & Food -->
    <div class="mb-16">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-2">Restaurants & Food</h2>
      <div class="w-12 h-1 bg-brand-pink mb-8"></div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Garozzo's Italian Restaurant</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">K-Machos Mexican Cuisine</p></div>
      </div>
    </div>

    <!-- Community & Nonprofit -->
    <div class="mb-16">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-2">Community & Nonprofit</h2>
      <div class="w-12 h-1 bg-brand-pink mb-8"></div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Hearing the Call</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Indian Creek Community Church</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Kansas City Zoo</p></div>
      </div>
    </div>

    <!-- Financial & Home Care -->
    <div class="mb-16">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-2">Financial & Home Care</h2>
      <div class="w-12 h-1 bg-brand-pink mb-8"></div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">Annuities and More</p></div>
        <div class="bg-gray-50 rounded-xl p-6 border border-gray-100 text-center hover:border-brand-pink/30 transition-colors"><p class="font-semibold text-gray-900">The Piper HomeCare</p></div>
      </div>
    </div>

  </div>
</section>

<!-- CTA -->
<section class="py-20 px-6 bg-gray-900">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-6">
      Ready to Join <span class="bg-gradient-to-r from-brand-pink-light to-brand-pink bg-clip-text text-transparent">Our Partners?</span>
    </h2>
    <p class="text-gray-300 text-lg mb-10">
      Let's talk about what we can achieve together. We'll put together a free proposal tailored to your business and budget.
    </p>
    <a href="/contact" class="btn-primary text-lg !px-10 !py-4">Get Your Free Proposal</a>
  </div>
</section>

</Layout>
