const { slug } = Astro.params;
const post = posts[slug];
if (!post) return Astro.redirect('/blog');

function renderInline(text) {
  return text
    .replace(/!\[([^\]]+)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" loading="lazy" style="max-width:100%;height:auto;border-radius:8px;margin:2rem 0" />')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>');
}

function renderMarkdown(md) {
  const blocks = md.trim().split('\n\n');
  const html = [];
  // The page template renders the post title as the one <h1>. Some bodies repeat it as a
  // leading "# " heading, which gave those pages two H1s — drop that first heading only.
  if (blocks.length && /^#\s+/.test(blocks[0].trim())) blocks.shift();
  for (const block of blocks) {
    const trimmed = block.trim();
    if (!trimmed) continue;
    if (/^-{3,}$/.test(trimmed)) { html.push('<hr />'); continue; }
    const imgMatch = trimmed.match(/^!\[([^\]]*)\]\(([^)]+)\)$/);
    if (imgMatch) { html.push(`<img src="${imgMatch[2]}" alt="${imgMatch[1]}" loading="lazy" style="max-width:100%;height:auto;border-radius:8px;margin:2rem 0" />`); continue; }
    const heading = trimmed.match(/^(#{1,3})\s+(.*)$/);
    if (heading) { const level = heading[1].length; html.push(`<h${level}>${renderInline(heading[2])}</h${level}>`); continue; }
    const lines = trimmed.split('\n');
    if (lines.every((line) => /^-\s+/.test(line.trim()))) {
      html.push(`<ul>${lines.map((line) => `<li>${renderInline(line.trim().replace(/^-\s+/, ''))}</li>`).join('')}</ul>`);
      continue;
    }
    if (lines.every((line) => /^\d+\.\s+/.test(line.trim()))) {
      html.push(`<ol>${lines.map((line) => `<li>${renderInline(line.trim().replace(/^\d+\.\s+/, ''))}</li>`).join('')}</ol>`);
      continue;
    }
    html.push(`<p>${renderInline(lines.join(' '))}</p>`);
  }
  return html.join('\n');
}

const postHtml = renderMarkdown(post.body);
const metaDesc = post.body.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/[*#_>`]/g, '').replace(/\s+/g, ' ').trim().slice(0, 155).replace(/\s\S*$/, '');
const siteUrl = 'https://onetakewondermarketing.com';
const postUrl = `${siteUrl}/blog/${slug}`;
const publishedIso = new Date(post.date).toISOString();
// Machine-readable date for <time datetime>; engines score the datestamp, not the prose.
const publishedDate = publishedIso.slice(0, 10);
const wordCount = post.body.replace(/[#*_`>\[\]()]/g, ' ').split(/\s+/).filter(Boolean).length;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: metaDesc,
  url: postUrl,
  datePublished: publishedIso,
  dateModified: post.updated ? new Date(post.updated).toISOString() : publishedIso,
  articleSection: post.tag,
  wordCount,
  inLanguage: 'en-US',
  image: `${siteUrl}/MarketingBanner.jpg`,
  author: { '@type': 'Organization', name: 'One Take Wonder Marketing', url: siteUrl },
  publisher: { '@type': 'Organization', name: 'One Take Wonder Marketing', url: siteUrl, logo: { '@type': 'ImageObject', url: `${siteUrl}/logo.png` } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  isPartOf: { '@type': 'Blog', '@id': `${siteUrl}/blog`, name: 'One Take Wonder Marketing Blog' },
};

// Several posts are written as Q&A: their "##" headings are questions and the prose
// underneath is the answer. Where a post has 3+ such headings, publish them as FAQPage
// so engines can lift the answer directly. Derived from the body, never hand-maintained,
// so it cannot drift from what the page actually says.
const QUESTION_HEADING = /^(what|when|where|why|how|who|which|can|do|does|is|are|should|will)\b/i;

function extractFaq(md) {
  const out = [];
  let current = null;
  for (const block of md.trim().split('\n\n')) {
    const trimmed = block.trim();
    if (!trimmed) continue;
    const heading = trimmed.match(/^(#{2,3})\s+(.*)$/);
    if (heading) {
      const text = heading[2].replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/[*_`]/g, '').trim();
      const isQuestion = text.endsWith('?') || QUESTION_HEADING.test(text);
      current = isQuestion ? { question: text, answer: [] } : null;
      if (current) out.push(current);
      continue;
    }
    if (!current) continue;
    if (/^!\[/.test(trimmed)) continue;          // an image is not an answer
    const lines = trimmed.split('\n');
    // A bulleted or numbered list under a question is still the answer — flatten it to
    // sentences rather than dropping it, or posts that answer in lists get no markup.
    const isList = lines.every((l) => /^(-|\d+\.)\s+/.test(l.trim()));
    const text = (isList
      ? lines.map((l) => l.trim().replace(/^(-|\d+\.)\s+/, '')).join('; ')
      : lines.join(' '))
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/[*_`#>]/g, '').trim();
    if (text && current.answer.length < 2) current.answer.push(text);
  }
  return out.filter((f) => f.answer.length > 0);
}

const faqItems = extractFaq(post.body);
const faqSchema = faqItems.length >= 2 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${postUrl}#faq`,
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer.join(' ') },
  })),
} : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
    { '@type': 'ListItem', position: 3, name: post.title, item: postUrl },
  ],
};
