---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'One Take Wonder Marketing | Full-Service Marketing Agency',
  description = 'Full-service marketing agency with 10+ years of experience. Custom strategies built around your budget with proven ROI. TV, digital, creative, web design.',
  canonical = '',
  ogImage = '/MarketingBanner.jpg',
} = Astro.props;

const siteUrl = 'https://onetakewondermarketing.com';
const currentUrl = canonical ? `${siteUrl}/${canonical.replace(/^\//, '')}` : siteUrl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="One Take Wonder Marketing" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["ProfessionalService", "LocalBusiness"],
      "@id": `${siteUrl}/#organization`,
      "name": "One Take Wonder Marketing",
      "url": siteUrl,
      "logo": `${siteUrl}/logo.png`,
      "image": `${siteUrl}/MarketingBanner.jpg`,
      "description": "Full-service marketing agency with over 10 years of experience helping local businesses grow with customized strategies based on their budget.",
      "telephone": "+13214838762",
      "email": "pearl@onetakewonderproductions.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "11454 Chateaubriand Ave",
        "addressLocality": "Orlando",
        "addressRegion": "FL",
        "postalCode": "32836",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 28.4308339,
        "longitude": -81.5555657
      },
      "areaServed": { "@type": "Country", "name": "United States" },
      "priceRange": "$$",
      "paymentAccepted": "Credit Card",
      "sameAs": [
        "https://www.instagram.com/onetakewondermarketing/",
        "https://www.facebook.com/onetakewondermarketing"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "telephone": "+13214838762",
        "email": "pearl@onetakewonderproductions.com",
        "availableLanguage": "en"
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Marketing Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Media Buying", "description": "Strategic ad placement across TV, streaming, and digital." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "TV & Streaming Advertising", "description": "Connected TV and OTT campaigns." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "PPC & Paid Search", "description": "High-intent paid search campaigns." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Social Media Advertising", "description": "Paid social across Meta, TikTok, and more." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "SEO & SEM", "description": "Search engine optimization and marketing." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Web Design & Development", "description": "Conversion-focused website design." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Creative & Content", "description": "Brand creative and content." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Brand Strategy", "description": "Positioning, messaging, and go-to-market strategy." } }
        ]
      },
      "potentialAction": {
        "@type": "ContactAction",
        "name": "Contact One Take Wonder Marketing",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": `${siteUrl}/contact`,
          "actionPlatform": "https://schema.org/DesktopWebPlatform",
          "httpMethod": "GET",
          "contentType": "text/html"
        }
      }
    })} />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <meta name="google-site-verification" content="Nlw5vCiMRDgyXKCN43_qwUzvbuTNb1qXNWdJsbl8kOs" />
    <slot name="head" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LT31Z70DB2"></script>
    <!-- is:inline is REQUIRED. Without it Astro bundles this as
         <script type="module"> and minifies the function name, so `gtag` is
         module-scoped under a mangled name and `window.gtag` is undefined.
         Every custom event guarded by `typeof window.gtag === 'function'`
         (lead submissions, call-click tracking) then silently never fires,
         while pageviews keep working because those come from gtag/js itself.
         window.gtag is also assigned explicitly so the global survives any
         future bundling change. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-LT31Z70DB2');
    </script>
    <!-- First-touch attribution capture.
         Deliberately uses ONLY document.referrer / location / sessionStorage —
         no gtag, no third-party request. A blocked visitor still gets captured,
         which is the entire point: on 2026-09-03 a real lead arrived from
         someone GA4 never saw (no session, no pageview, no event), so its source
         was unrecoverable. The form POSTs this to our own function.
         is:inline for the same reason as the block above — bundling would scope
         it to a module and it must run before any navigation.
         Written once per tab and never overwritten, so browsing / -> /contact
         still reports the ORIGINAL source rather than an internal referrer. -->
    <script is:inline>
      (function () {
        try {
          var KEY = 'rl_attr';
          if (sessionStorage.getItem(KEY)) return;
          var host = location.hostname.replace(/^www\./, '');
          var ref = document.referrer || '';
          var refHost = '', refClean = '';
          if (ref) {
            try {
              var u = new URL(ref);
              refHost = u.hostname.replace(/^www\./, '');
              refClean = u.origin + u.pathname;
            } catch (e) {}
          }
          if (refHost === host) { refHost = ''; refClean = ''; }
          var p = new URLSearchParams(location.search);
          sessionStorage.setItem(KEY, JSON.stringify({
            referrer: refClean,
            referrer_host: refHost,
            landing_page: location.pathname,
            utm_source: p.get('utm_source') || '',
            utm_medium: p.get('utm_medium') || '',
            utm_campaign: p.get('utm_campaign') || '',
            gclid: p.get('gclid') || ''
          }));
        } catch (e) { /* private mode / storage disabled — form still submits */ }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      document.addEventListener('click', (event) => {
        const target = event.target;
        const link = target instanceof Element ? target.closest('a[href^="tel:"]') : null;
        if (!link) return;

        if (typeof window.gtag === 'function') {
          window.gtag('event', 'click_to_call', {
            customer_id: 'bg_113610_002aea',
            link_location: link.getAttribute('data-call-location') || 'unknown',
            page_path: window.location.pathname,
            event_version: 1,
            transport_type: 'beacon',
          });
        }
      });
    </script>
  </body>
</html>
