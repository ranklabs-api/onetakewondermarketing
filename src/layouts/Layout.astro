---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title = 'One Take Wonder Marketing | Full-Service Marketing Agency',
  description = 'Full-service marketing agency with 10+ years of experience. Custom strategies built around your budget with proven ROI. TV, digital, creative, web design.',
  canonical = '',
  ogImage = '/MarketingBanner.jpg',
} = Astro.props;

const siteUrl = 'https://onetakewondermarketing.com';
const currentUrl = canonical ? `${siteUrl}/${canonical.replace(/^\//, '')}` : siteUrl;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="One Take Wonder Marketing" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "One Take Wonder Marketing",
      "description": "Full-service marketing agency with over 10 years of experience helping local businesses grow with customized strategies based on their budget.",
      "url": siteUrl,
      "telephone": "+13214838762",
      "email": "pearl@onetakewonderproductions.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Orlando",
        "addressRegion": "FL",
        "addressCountry": "US"
      },
      "image": `${siteUrl}/MarketingBanner.jpg`,
      "priceRange": "$$",
      "sameAs": [
        "https://www.instagram.com/onetakewondermarketing/",
        "https://www.facebook.com/onetakewondermarketing"
      ]
    })} />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <meta name="google-site-verification" content="Nlw5vCiMRDgyXKCN43_qwUzvbuTNb1qXNWdJsbl8kOs" />
    <slot name="head" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LT31Z70DB2"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-LT31Z70DB2');
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
